{
  "name": "Hostzera AI Chat Widget - Retrieval Grounded",
  "description": "Sanitized template of the production chat widget workflow. Replace credential references and Sheet IDs before deploying.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hostzera-chat",
        "responseMode": "lastNode"
      },
      "id": "webhook",
      "name": "Chat Widget Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "documentId": "REPLACE_WITH_KB_SHEET_ID",
        "sheetName": "KnowledgeBase",
        "options": {}
      },
      "id": "get-kb",
      "name": "Get Knowledge Base",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [420, 200],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "documentId": "REPLACE_WITH_SESSION_SHEET_ID",
        "sheetName": "Conversations",
        "filtersUI": {
          "values": [{ "lookupColumn": "session_id", "lookupValue": "={{ $('Chat Widget Webhook').first().json.session_id }}" }]
        }
      },
      "id": "get-history",
      "name": "Get Session History",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [420, 400]
    },
    {
      "parameters": {
        "jsCode": "// See code_examples.md Section 1: Knowledge Base Retrieval\n// Scores KB rows against user message, returns top 5\nreturn $input.all();"
      },
      "id": "kb-retrieval",
      "name": "KB Retrieval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 200]
    },
    {
      "parameters": {
        "jsCode": "// See code_examples.md Section 5: Language Detection\nreturn $input.all();"
      },
      "id": "lang-detect",
      "name": "Detect Language",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 400]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "claude-3-5-sonnet-20241022",
        "messages": {
          "values": [
            { "role": "system", "content": "You are Hostzera's AI assistant. ANSWER ONLY from retrieved context. If not in context, say: 'Let me connect you with our team.' Respond in {{ $('Detect Language').first().json.detected_language }}." },
            { "role": "user", "content": "Retrieved context:\n{{ $('KB Retrieval').first().json.retrieved_context }}\n\nUser: {{ $('Chat Widget Webhook').first().json.message }}" }
          ]
        },
        "options": { "temperature": 0.3 }
      },
      "id": "ai-claude",
      "name": "AI Response - Claude",
      "type": "n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [860, 300]
    },
    {
      "parameters": {
        "jsCode": "// See code_examples.md Section 3: Page Link Auto-Insertion\nreturn $input.all();"
      },
      "id": "link-enrich",
      "name": "Enrich with Page Links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": "REPLACE_WITH_SESSION_SHEET_ID",
        "sheetName": "Conversations",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $now.toISO() }}",
            "session_id": "={{ $('Chat Widget Webhook').first().json.session_id }}",
            "user_message": "={{ $('Chat Widget Webhook').first().json.message }}",
            "ai_response": "={{ $json.response }}",
            "language": "={{ $('Detect Language').first().json.detected_language }}"
          }
        }
      },
      "id": "log-conv",
      "name": "Log Conversation",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { reply: $json.response, session_id: $('Chat Widget Webhook').first().json.session_id } }}"
      },
      "id": "respond",
      "name": "Return to Widget",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1520, 300]
    }
  ],
  "connections": {
    "Chat Widget Webhook": { "main": [[ { "node": "Get Knowledge Base", "type": "main", "index": 0 }, { "node": "Get Session History", "type": "main", "index": 0 } ]] },
    "Get Knowledge Base": { "main": [[ { "node": "KB Retrieval", "type": "main", "index": 0 } ]] },
    "Get Session History": { "main": [[ { "node": "Detect Language", "type": "main", "index": 0 } ]] },
    "KB Retrieval": { "main": [[ { "node": "AI Response - Claude", "type": "main", "index": 0 } ]] },
    "Detect Language": { "main": [[ { "node": "AI Response - Claude", "type": "main", "index": 0 } ]] },
    "AI Response - Claude": { "main": [[ { "node": "Enrich with Page Links", "type": "main", "index": 0 } ]] },
    "Enrich with Page Links": { "main": [[ { "node": "Log Conversation", "type": "main", "index": 0 } ]] },
    "Log Conversation": { "main": [[ { "node": "Return to Widget", "type": "main", "index": 0 } ]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["chat-widget", "retrieval-grounded", "multi-language"]
}
